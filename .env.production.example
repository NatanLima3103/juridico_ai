APP_ENV=production
ENV_FILE=.env.production
DEBUG=false
APP_NAME=Juridico AI
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
DOMAIN=juridico.example.com
ACME_EMAIL=admin@example.com
NGINX_HTTP_PORT=80

POSTGRES_DB=juridico_ai
POSTGRES_USER=juridico_ai
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Para banco gerenciado/externo, descomente e ajuste:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/juridico_ai

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=true

UPLOAD_DIR=storage/uploads
GENERATIONS_DIR=storage/generations
MAX_UPLOAD_SIZE_MB=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=2200
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_VECTOR_DIMENSION=128

FREE_PLAN_DAILY_GENERATION_LIMIT=10
PRO_PLAN_MONTHLY_GENERATION_LIMIT=1000
FREE_PLAN_WRITING_PROFILE_LIMIT=5
PRO_PLAN_WRITING_PROFILE_LIMIT=25

PAYMENT_PROVIDER=manual
PAYMENT_CHECKOUT_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENT_WEBHOOK_SECRET=

SOFT_DELETED_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
